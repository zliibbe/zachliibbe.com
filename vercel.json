{
  "crons": [
    {
      "path": "/api/admin/cron/publish",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "src/app/api/admin/cron/**": {
      "maxDuration": 30
    },
    "src/app/api/blog/**": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/api/admin/cron/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-cron"
        }
      ],
      "destination": "/api/admin/cron/$1",
      "permanent": false
    }
  ]
}
